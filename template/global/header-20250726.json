              <div class=\"search-input-group\">\n                    <input \n                        type=\"search\" \n                        class=\"search-input\" \n                        name=\"s\" \n                        placeholder=\"\u8f38\u5165\u641c\u5c0b\u95dc\u9375\u5b57...\" \n                        autocomplete=\"off\"\n                        required\n                    \/>\n                    <button type=\"submit\" class=\"search-submit\">\n                        <i class=\"fas fa-search\"><\/i>\n                        <span>\u641c\u5c0b<\/span>\n                    <\/button>\n                <\/div>\n            <\/form>\n            \n            <p class=\"search-hint\">\u6309 Enter \u9375\u6216\u9ede\u64ca\u641c\u5c0b\u6309\u9215\u958b\u59cb\u641c\u5c0b<\/p>\n        <\/div>\n    <\/div>\n<\/div>\n<script>\njQuery(document).ready(function($) {\n    \n    \/\/ \u8a2d\u5b9a\u8868\u55ae\u7684 action \u70ba\u7576\u524d\u7db2\u7ad9\u9996\u9801\n    $('#search-form').attr('action', window.location.origin);\n    \n    \/\/ \u89f8\u767c\u5168\u5c4f\u641c\u5c0b\n    $('#search-trigger').on('click', function(e) {\n        e.preventDefault();\n        openFullscreenSearch();\n    });\n    \n    \/\/ \u95dc\u9589\u641c\u5c0b - \u9ede\u64ca\u95dc\u9589\u6309\u9215\n    $('#search-close').on('click', function() {\n        closeFullscreenSearch();\n    });\n    \n    \/\/ \u95dc\u9589\u641c\u5c0b - \u9ede\u64ca\u80cc\u666f\n    $('#fullscreen-search').on('click', function(e) {\n        if (e.target === this) {\n            closeFullscreenSearch();\n        }\n    });\n    \n    \/\/ \u95dc\u9589\u641c\u5c0b - ESC \u9375\n    $(document).keyup(function(e) {\n        if (e.keyCode === 27 && $('#fullscreen-search').hasClass('active')) {\n            closeFullscreenSearch();\n        }\n    });\n    \n    \/\/ Enter \u9375\u63d0\u4ea4\u641c\u5c0b\n    $('.search-input').keypress(function(e) {\n        if (e.which === 13) {\n            e.preventDefault();\n            submitSearch();\n        }\n    });\n    \n    \/\/ \u641c\u5c0b\u8868\u55ae\u63d0\u4ea4\u8655\u7406\n    $('#search-form').on('submit', function(e) {\n        e.preventDefault();\n        submitSearch();\n    });\n    \n    \/\/ \u63d0\u4ea4\u641c\u5c0b\u51fd\u6578\n    function submitSearch() {\n        const searchTerm = $('.search-input').val().trim();\n        \n        if (searchTerm === '') {\n            $('.search-input').focus();\n            $('.search-input-group').addClass('shake');\n            setTimeout(function() {\n                $('.search-input-group').removeClass('shake');\n            }, 600);\n            return false;\n        }\n        \n        \/\/ \u8df3\u8f49\u5230\u641c\u5c0b\u7d50\u679c\u9801\u9762\n        const searchUrl = window.location.origin + '\/?s=' + encodeURIComponent(searchTerm);\n        window.location.href = searchUrl;\n    }\n    \n    \/\/ \u6253\u958b\u5168\u5c4f\u641c\u5c0b\n    function openFullscreenSearch() {\n        $('#fullscreen-search').addClass('active');\n        $('body').css('overflow', 'hidden');\n        \n        setTimeout(function() {\n            $('.search-input').focus();\n        }, 300);\n    }\n    \n    \/\/ \u95dc\u9589\u5168\u5c4f\u641c\u5c0b\n    function closeFullscreenSearch() {\n        $('#fullscreen-search').removeClass('active');\n        $('body').css('overflow', 'auto');\n        $('.search-input').val('').blur();\n    }\n    \n    \/\/ \u963b\u6b62\u8868\u55ae\u5bb9\u5668\u7684\u9ede\u64ca\u4e8b\u4ef6\u5192\u6ce1\n    $('.search-container').on('click', function(e) {\n        e.stopPropagation();\n    });\n});\n<\/script>","_margin":{"unit":"px","top":"0","right":"0","bottom":"0","left":"0","isLinked":true},"_padding":{"unit":"px","top":"0","right":"0","bottom":"0","left":"0","isLinked":true},"display_condition_list":[{"display_condition_login_status":"subscriber","_id":"6bb1d59"}],"custom_css":"\/* \u5168\u5c4f\u641c\u5c0b\u8986\u84cb\u5c64 *\/\n.fullscreen-search-overlay {\n    position: fixed;\n    top: 0;\n    left: 0;\n    width: 100vw;\n    height: 100vh;\n    background: rgba(0, 0, 0, 0.25);\n    backdrop-filter: blur(10px);\n    z-index: 99999;\n    display: none;\n    align-items: center;\n    justify-content: center;\n    opacity: 0;\n    transition: all 0.3s ease;\n}\n\n.fullscreen-search-overlay.active {\n    display: flex;\n    opacity: 1;\n}\n\n\/* \u641c\u5c0b\u5bb9\u5668 *\/\n.search-container {\n    position: relative;\n    width: 90%;\n    max-width: 600px;\n    text-align: center;\n}\n\n\/* \u95dc\u9589\u6309\u9215 *\/\n.search-close {\n    position: absolute;\n    top: -60px;\n    right: 0;\n    color: #ffffff;\n    font-size: 24px;\n    cursor: pointer;\n    transition: color 0.3s ease;\n    padding: 10px;\n}\n\n.search-close:hover {\n    color: var(--e-global-color-primary);\n    transform: scale(1.1);\n}\n\n\/* \u641c\u5c0b\u8868\u55ae\u5305\u88dd *\/\n.search-form-wrapper {\n    position: relative;\n}\n\n\/* \u641c\u5c0b\u8f38\u5165\u7fa4\u7d44 *\/\n.search-input-group {\n    position: relative;\n    display: flex;\n    background: #ffffff;\n    border-radius: 50px;\n    overflow: hidden;\n    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.3);\n    transition: transform 0.3s ease;\n}\n\n.search-input-group:focus-within {\n    transform: translateY(-2px);\n    box-shadow: 0 15px 40px rgba(0, 0, 0, 0.4);\n}\n\n\/* \u641c\u5c0b\u8f38\u5165\u6846 *\/\n.search-input {\n    flex: 1;\n    padding: 20px 25px;\n    font-size: 18px;\n    border: none;\n    outline: none;\n    background: transparent;\n    color: #333333;\n    font-family: inherit;\n}\n\n.search-input::placeholder {\n    color: #999999;\n    transition: color 0.3s ease;\n}\n\n.search-input:focus::placeholder {\n    color: #cccccc;\n}\n\n\/* \u641c\u5c0b\u6309\u9215 *\/\n.search-submit {\n    padding: 20px 30px;\n    background: var(--e-global-color-primary);\n    border: none;\n    color: #ffffff;\n    font-size: 16px;\n    font-weight: 600;\n    cursor: pointer;\n    transition: all 0.3s ease;\n    display: flex;\n    align-items: center;\n    gap: 8px;\n}\n\n.search-submit:hover {\n    background: var(--e-global-color-accent);\n    transform: scale(1.05);\n}\n\n.search-submit i {\n    font-size: 18px;\n}\n\n\/* \u641c\u5c0b\u63d0\u793a *\/\n.search-hint {\n    color: #cccccc;\n    font-size: 14px;\n    margin-top: 20px;\n    opacity: 0.8;\n}\n\n\/* \u89f8\u767c\u6309\u9215\u6a23\u5f0f *\/\n{{WRAPPER}} #search-trigger {\n    cursor: pointer;\n    transition: all 0.3s ease;\n}\n\n{{WRAPPER}} #search-trigger:hover {\n    transform: scale(1.1);\n}\n\n\/* \u97ff\u61c9\u5f0f\u8a2d\u8a08 *\/\n@media (max-width: 768px) {\n    .search-container {\n        width: 95%;\n        padding: 0 10px;\n    }\n    \n    .search-input {\n        padding: 15px 20px;\n        font-size: 16px;\n    }\n    \n    .search-submit {\n        padding: 15px 25px;\n    }\n    \n    .search-submit span {\n        display: none;\n    }\n    \n    .search-close {\n        top: -50px;\n        font-size: 20px;\n    }\n}\n\n\/* \u52d5\u756b\u6548\u679c *\/\n@keyframes searchFadeIn {\n    from {\n        opacity: 0;\n        transform: scale(0.9) translateY(20px);\n    }\n    to {\n        opacity: 1;\n        transform: scale(1) translateY(0);\n    }\n}\n\n.fullscreen-search-overlay.active .search-container {\n    animation: searchFadeIn 0.3s ease;\n}\n\n\/* \u932f\u8aa4\u63d0\u793a\u52d5\u756b *\/\n@keyframes shake {\n    0%, 100% { transform: translateX(0); }\n    10%, 30%, 50%, 70%, 90% { transform: translateX(-5px); }\n    20%, 40%, 60%, 80% { transform: translateX(5px); }\n}\n\n.search-input-group.shake {\n    animation: shake 0.6s ease-in-out;\n}"},"elements":[],"isInner":false,"widgetType":"html","elType":"widget"}],"isInner":false,"elType":"container"}],"page_settings":[],"version":"0.4","title":"Header001","type":"header"}